#!/usr/bin/env python3
"""Use the project's virtual environment and source tree."""
import os
import sys
from pathlib import Path

root = Path(__file__).resolve().parent.parent
python = root / ".venv/bin/python"
if not python.exists():
    raise SystemExit("Create .venv and install requirements.txt first; see README.md")
environment = dict(os.environ)
environment["PYTHONPATH"] = str(root / "src")
os.execve(python, [str(python), "-m", "claude_codex_bridge", *sys.argv[1:]], environment)
